{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "../api-server/src/routes",
    "../api-server/src/lib/build-visual-verification.ts",
    "../api-server/src/lib/build-done-contract.ts",
    "../api-server/src/lib/build-human-interface.ts",
    "../api-server/src/lib/model-router.ts",
    "../api-server/src/lib/build-project-map.ts",
    "../api-server/src/lib/build-skills.ts",
    "../api-server/src/lib/deep-research-v2.ts",
    "../api-server/src/lib/promo-maker.ts",
    "../api-server/src/lib/virtual-worktree.ts",
    "../api-server/src/lib/parallel-agents.ts"
  ]
}
