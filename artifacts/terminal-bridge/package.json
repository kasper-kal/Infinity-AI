{
  "name": "infinity-terminal-bridge",
  "version": "0.1.0",
  "description": "Local terminal bridge for Infinity - WebSocket bridge to node-pty for real terminal in browser",
  "main": "dist/index.js",
  "bin": {
    "infinity-terminal-bridge": "bin/bridge.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "terminal",
    "pty",
    "websocket",
    "infinity",
    "bridge",
    "shell"
  ],
  "author": "Infinity AI",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "node-pty": "^1.0.0",
    "ws": "^8.16.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin"
  ]
}